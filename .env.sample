# JWT & Gateway Security Configuration
SECRET_KEY=your_very_secret_key_here
GATEWAY_SECRET=shared_secret_for_m2m_backend_apps
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de Base de Datos (PostgreSQL / PgBouncer)
# Conexión directa: 5432 | Conexión vía PgBouncer: 6432
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gateway_auth

# Configuración de Redis (Caché de Sesiones, Proxy y Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=60

# Usuario admin
EMAIL_ADMIN=admin@gmail.com
PASSWORD_ADMIN=123456

# Origen para gateway
ORIGIN=http://localhost:5173

# Configuración Unificada de Microservicios (Particionamiento Zero-Trust)
# Formato: {"prefijo": {"url": "...", "api_key": "...", "allowed_clients": ["..."], "required_roles": ["..."], "public_paths": ["..."], "allow_anonymous": false}}
# NOTA ZERO-TRUST: Si allowed_clients está vacío u omitido, el servicio queda BLOQUEADO (403 Forbidden).
# Para permitir cualquier cliente use ["*"]. Para rutas públicas use "public_paths": ["/items", "/marketplace"].
MICROSERVICES='{
    "reservas": {
        "url": "http://localhost:4000",
        "api_key": "secret-key-reservas-123",
        "allowed_clients": ["reservas-web", "hostess-pwa"],
        "public_paths": ["/marketplace", "/cities"]
    },
    "ventas": {
        "url": "http://localhost:8001",
        "api_key": "secret-key-ventas-123",
        "allowed_clients": ["comensales-app", "staff-pos", "admin-portal"]
    },
    "stock": {
        "url": "http://localhost:8002",
        "api_key": "secret-key-stock-456",
        "allowed_clients": ["staff-pos", "admin-portal"],
        "required_roles": ["USER", "ADMIN"]
    }
}'
