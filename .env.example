# JWT & Gateway Security Configuration
SECRET_KEY=your_very_secret_key_here
GATEWAY_SECRET=shared_secret_for_m2m_backend_apps
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuración de Base de Datos (PostgreSQL / PgBouncer)
# Conexión directa: 5432 | Conexión vía PgBouncer: 6432
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gateway_auth

# Configuración de Redis (Caché de Sesiones, Proxy y Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=60
RATE_LIMIT_PROXY_PER_MINUTE=300

# Usuario admin
EMAIL_ADMIN=admin@gmail.com
PASSWORD_ADMIN=123456

# Origenes CORS permitidos (formato JSON Array)
ORIGIN='["http://localhost:5173", "http://localhost:3000"]'

# Timeouts del servidor HTTP (en segundos)
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=60
HTTP_IDLE_TIMEOUT=60

# Telemetría y Tracing Distribuido (OpenTelemetry / Jaeger)
# Local: http://localhost:4318 | Railway: http://jaeger.railway.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api-gateway

# Configuración Unificada de Microservicios (Particionamiento Zero-Trust)
# Formato: {"prefijo": {"url": "...", "api_key": "...", "allowed_clients": ["..."], "required_roles": ["..."], "public_paths": ["..."], "allow_anonymous": false, "passthrough_headers": ["..."]}}
# NOTA ZERO-TRUST: Si allowed_clients está vacío u omitido, el servicio queda BLOQUEADO (403 Forbidden).
# Para permitir cualquier cliente use ["*"]. Para rutas públicas use "public_paths": ["/items", "/marketplace"].
MICROSERVICES='{
    "reservas": {
        "url": "http://localhost:4000",
        "api_key": "secret-key-reservas-123",
        "allowed_clients": ["reservasmanager", "reservas-web", "hostess-pwa"],
        "public_paths": [
            "/api/v1/marketplace",
            "/api/v1/auth/register",
            "POST /api/v1/reservations",
            "/api/v1/reservations/manage",
            "POST /api/v1/reviews",
            "GET /api/v1/restaurants$"
        ],
        "passthrough_headers": [
            "X-Restaurant-Id",
            "X-Timezone"
        ],
        "cache_ttl_seconds": 0
    },
    "asistente-citas": {
        "url": "http://localhost:8005",
        "api_key": "clave_secreta_compartida_con_el_gateway",
        "allowed_clients": ["*"],
        "public_paths": [
            "/api/v1/webhook"
        ],
        "passthrough_headers": [
            "X-Telegram-Bot-Api-Secret-Token",
            "X-Hub-Signature-256"
        ],
        "timeout_seconds": 60
    }
}'
